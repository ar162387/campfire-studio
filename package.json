{
  "name": "campfire-studio",
  "version": "2.1.0",
  "private": true,
  "description": "Reusable procedural 3D dialogue reel studio and portable agent skill",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/build-data.mjs && node --test tests/*.test.mjs",
    "doctor": "node tools/render.mjs --doctor",
    "render": "node tools/render.mjs",
    "episode:check": "node tools/content-system.mjs check",
    "pack": "node tools/package.mjs",
    "gallery": "node tools/gallery.mjs",
    "voice:prepare": "python3 tools/voice-scene.py prepare",
    "voice:dialogue": "node --env-file=.env.local tools/voice-dialogue.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.75.0",
    "@fontsource/inter": "5.2.8",
    "@react-three/fiber": "9.8.2",
    "puppeteer": "25.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
